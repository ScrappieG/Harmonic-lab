{
  "manifest_version": 3,
  "name": "ArticuLeet",
  "version": "1.0.0",
  "description": "AI-powered technical interview practice on LeetCode",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
