{
  "manifest_version": 3,
  "name": "articuLeet",
  "version": "1.0.0",
  "description": "Practice articulating your LeetCode solutions aloud.",
  "action": {
    "default_icon": {
      "48": "icons/icon_48.png",
      "300": "icons/icon_300.png"
    }
  },
  "icons": {
    "48": "icons/icon_48.png",
    "300": "icons/icon_300.png"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://articuleet.workers.dev/*"],
  "externally_connectable": {
    "matches": ["https://articuleet.com/*", "https://www.articuleet.com/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/*"],
      "js": ["widget-html.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["widget.css"],
      "matches": ["*://leetcode.com/*"]
    }
  ]
}