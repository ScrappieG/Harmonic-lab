{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "articuleet",
  "main": "backend/app.py",

  "compatibility_date": "2026-02-20",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],

  "observability": {
    "enabled": true
  },

  "env": {
    "production": {
      "routes": [
        {
          "pattern": "api.articuleet.com/*",
          "zone_name": "articuleet.com"
        }
      ]
    }
  }
}

//uv run pywrangler deploy --env="" - for dev (default is dev branch)
// uv run pywrangler deploy --env production for prd (once we get articuleet.com)